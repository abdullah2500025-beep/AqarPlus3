{
  "name": "aqarplus-rems",
  "private": true,
  "version": "1.0.0",
  "description": "AqarPlus Real Estate Management System (Desktop, Web PWA & Cloudflare Workers)",
  "author": "AqarPlus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:desktop": "npm run build && npm run build:server",
    "build:worker": "esbuild worker/src/index.ts --bundle --format=esm --outfile=dist-worker/worker.js --external:cloudflare:workers",
    "dist:win": "npm run build:desktop && electron-builder --win --config electron-builder.yml",
    "deploy:worker": "npm run build && npm run build:worker && wrangler deploy",
    "electron:start": "electron electron/main.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-worker release server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "lint": "tsc --noEmit",
    "test:node": "node scripts/verify-system.mjs",
    "test:offline": "tsx scripts/verify-offline.mjs",
    "test:worker": "node scripts/verify-worker.mjs",
    "test": "node scripts/verify-system.mjs && tsx scripts/verify-offline.mjs && node scripts/verify-worker.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.162.0"
  }
}
